<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainContentPane" prefHeight="456.0" prefWidth="537.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autorental.controllers.AjoutVehicule">
    <children>
        <ScrollPane>
            <content>
                <Pane prefHeight="523.0" prefWidth="538.0">
                    <children>
                        <Label layoutX="24.0" layoutY="24.0" text="Ajouter un Véhicule">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Pane layoutX="23.0" layoutY="59.0" prefHeight="464.0" prefWidth="492.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 9;">
                            <children>
                                <Label layoutX="112.0" layoutY="37.0" text="Marque" />
                                <TextField fx:id="brandField" layoutX="112.0" layoutY="54.0" prefHeight="25.0" prefWidth="270.0" />
                                <Label layoutX="112.0" layoutY="96.0" text="Modèle" />
                                <TextField fx:id="modelField" layoutX="112.0" layoutY="113.0" prefHeight="25.0" prefWidth="270.0" />
                                <Label layoutX="112.0" layoutY="164.0" text="Immatriculation" />
                                <TextField fx:id="licensePlateField" layoutX="112.0" layoutY="181.0" prefHeight="25.0" prefWidth="270.0" />
                                <Label layoutX="111.0" layoutY="227.0" text="Tarif" />
                                <TextField fx:id="tarifField" layoutX="111.0" layoutY="244.0" prefHeight="25.0" prefWidth="270.0" />
                                <ComboBox fx:id="availabilityChoice" layoutX="111.0" layoutY="320.0" prefHeight="25.0" prefWidth="270.0" />
                                <Button fx:id="saveButton" layoutX="157.0" layoutY="387.0" mnemonicParsing="false" onAction="#onEnregistrer" prefHeight="25.0" prefWidth="77.0" text="Enregistrer" />
                                <Button fx:id="cancelButton" layoutX="260.0" layoutY="387.0" mnemonicParsing="false" onAction="#onAnnuler" prefHeight="25.0" prefWidth="68.0" style="-fx-background-color: black;" text="Annuler" textFill="WHITE" />
                        <Label layoutX="111.0" layoutY="296.0" text="Disponibilité" />
                            </children>
                        </Pane>
                    </children>
                </Pane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
